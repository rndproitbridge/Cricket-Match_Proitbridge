# Copy to .env for local runs. In Dokploy paste these into the service's Environment tab.

# Postgres (the db container creates this user and database on first start)
POSTGRES_USER=cricket
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=cricket

# The one login allowed to score. Everyone else watches without logging in.
SCORER_EMAIL=scorer@example.com
SCORER_PASSWORD=change-me

# Signs the scorer's login. 32+ random characters, e.g. from: openssl rand -hex 32
# Changing it (or SCORER_PASSWORD) logs the scorer out on every device.
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32

# Optional: save each finished match to Google Drive. Leave empty to switch it off.
GOOGLE_CLIENT_ID=
DRIVE_FOLDER_NAME=PIB vs ZPX Cricket 2026 – Scorecards

# Local only: host port for docker-compose.local.yml
APP_PORT=3000
